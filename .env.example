# ---------------------------------------------------------------------------
# leadgen-agent -- copy to `.env` and fill in. `.env` is gitignored.
#
# NOTHING here is required for Step 1 (state schema) or Step 2 (config load).
# Each block notes the build step at which it first has to be real, so you can
# sign up for keys just ahead of needing them.
#
# Every service below has a free tier. Do not add a paid one.
# ---------------------------------------------------------------------------

# === Core =================================================================== #
# Comma-separated tenant ids this install is allowed to run.
LEADGEN_TENANTS=example_tenant
# Where per-tenant SQLite checkpoint DBs live (one file per tenant_id).
CHECKPOINT_DIR=./.data/checkpoints
# Where durable counters (Hunter quota, daily send counts) live.
COUNTER_DIR=./.data/counters
LOG_LEVEL=INFO


# === LLM  [needed: Step 4] ================================================== #
# groq | gemini | ollama | openai | anthropic | deepseek
#
# The first provider tried. Fallback runs through the FREE ones only -- groq,
# gemini, then a model on this machine -- so a workspace that has not chosen to
# spend money never starts spending it because a free tier was rate-limited.
# The metered providers below run when they are chosen, and not otherwise.
LLM_PROVIDER=groq

# Groq (primary). Free: console.groq.com -> API Keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Flash (alternate). Free: aistudio.google.com -> Get API key.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local fallback, no key, no quota). Install from ollama.com, then
# `ollama pull llama3.1:8b`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Bring your own account. Metered: you are billed by the provider. ------- #

# OpenAI. platform.openai.com -> API keys. NOT a ChatGPT subscription.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic. console.anthropic.com -> API keys. NOT a Claude subscription.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# DeepSeek. platform.deepseek.com -> API keys. Speaks the OpenAI API.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1


# === Observability  [needed: Step 4, optional] ============================== #
# Free: smith.langchain.com. Traces are tagged tenant_id + region.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=leadgen-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com


# === Discovery  [needed: Step 3] ============================================ #
# Google Places -- free monthly credit. console.cloud.google.com ->
# enable "Places API (New)" -> Credentials -> API key. SET A BUDGET CAP.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MONTHLY_REQUEST_CAP=2000

# OpenStreetMap / Nominatim fallback -- no key. Their policy REQUIRES a
# descriptive User-Agent with contact info, and max 1 request/second.
NOMINATIM_USER_AGENT=leadgen-agent/0.1 (ai-automation@kodexolabs.com)

# Apollo.io free plan. apollo.io -> Settings -> Integrations -> API.
APOLLO_API_KEY=
# Drop hand-exported LinkedIn Sales Navigator CSVs here for the import path.
APOLLO_CSV_IMPORT_DIR=./data/imports


# === Scraping / enrichment  [needed: Step 3] ================================ #
SCRAPER_USER_AGENT=leadgen-agent/0.1 (+https://kodexolabs.com/bot)
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_PAGES_PER_SITE=5
SCRAPER_RESPECT_ROBOTS=true

# Hunter.io free plan = 25 lookups/month, hard-enforced in code.
# hunter.io -> Dashboard -> API.
HUNTER_API_KEY=
HUNTER_MONTHLY_LOOKUP_CAP=25
HUNTER_QUOTA_FILE=./.data/counters/hunter_quota.json

# Anymail Finder (alternate). Metered, charged per verified address. The cap
# below is YOUR ceiling, not their plan limit -- it is what a runaway batch
# cannot spend past. Raise it deliberately.
ANYMAIL_FINDER_API_KEY=
ANYMAIL_FINDER_MONTHLY_LOOKUP_CAP=100


# === Translation  [needed: Step 5, only for non-English regions] ============ #
# DeepL API Free = 500k chars/month. deepl.com/pro-api -> Free plan.
DEEPL_API_KEY=
DEEPL_MONTHLY_CHAR_CAP=500000


# === Email sending  [needed: Step 7] ======================================== #
# gmail_smtp | brevo | smtp
EMAIL_PROVIDER=gmail_smtp

# Gmail SMTP (~500/day). Requires 2FA on the account, then an App Password:
# myaccount.google.com -> Security -> App passwords. NOT your login password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_DAILY_SEND_CAP=500

# Brevo (Sendinblue) free plan (~300/day). brevo.com -> SMTP & API -> API Keys.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_DAILY_SEND_CAP=300

# Any other mailbox: a work address, a hosting account, your own server.
# Port 465 connects over SSL from the first byte; anything else starts in the
# clear and upgrades with STARTTLS. The daily cap still applies -- a new
# sending domain that jumps to hundreds a day gets filtered, not delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DAILY_SEND_CAP=200


# === Reply monitoring  [needed: Step 8] ===================================== #
# gmail_api | imap
EMAIL_READER=imap

# Gmail API (OAuth). console.cloud.google.com -> enable Gmail API ->
# OAuth client (Desktop app) -> download JSON to the path below.
GMAIL_OAUTH_CLIENT_SECRETS_FILE=./.secrets/gmail_client_secret.json
GMAIL_OAUTH_TOKEN_FILE=./.secrets/gmail_token.json

# Plain IMAP polling (works with the same Gmail App Password as above).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
REPLY_LOOKBACK_DAYS=14


# === CRM / suppression  [needed: Step 6 (suppression), Step 9 (CRM)] ======== #
# google_sheets | airtable | hubspot | pipedrive | csv
CRM_BACKEND=google_sheets

# Google Sheets via gspread. Create a Google Cloud service account, enable
# Sheets + Drive APIs, download the JSON key, then SHARE each tenant
# spreadsheet with the service account email as an Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=./.secrets/google_service_account.json
# One spreadsheet per tenant. Add one line per tenant_id you run:
GOOGLE_SHEETS_SPREADSHEET_ID__example_tenant=

# Airtable free plan (alternate). airtable.com/create/tokens
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID__example_tenant=
AIRTABLE_TABLE_NAME=Leads

# HubSpot. Settings -> Integrations -> Private Apps. The app needs the
# crm.objects.contacts read and write scopes. Each lead lands as a contact;
# the score, the reason and the signals go into one `leadflow_summary`
# property, so nothing has to be set up in HubSpot before the first write.
HUBSPOT_API_KEY=

# Pipedrive. Personal preferences -> API. The domain is the first part of your
# Pipedrive address: for acme.pipedrive.com it is `acme`. One per tenant.
PIPEDRIVE_API_KEY=
PIPEDRIVE_DOMAIN__example_tenant=

# Suppression list. `local` keeps a per-tenant file; `crm` mirrors it into a
# suppression tab in the tenant sheet. `both` (default) writes to each.
SUPPRESSION_BACKEND=both
SUPPRESSION_DIR=./.data/suppression


# === Safety rails =========================================================== #
# Global kill switch. When true, N6a/N6b print instead of sending, regardless
# of the --dry-run flag. Leave true until you have run a real approval pass.
GLOBAL_DRY_RUN=true
# Refuse to send to these domains no matter what (your own, test, competitors).
BLOCKED_DOMAINS=example.com,test.com

# === Settings service  [needed: to use the dashboard] ======================= #
# The dashboard's Connections screen stores the user's API keys encrypted, in
# config/tenants/<workspace>/secrets.enc. THIS is the key that encrypts them.
#
# Generate it ONCE and keep it. Losing it does not damage the stored keys, it
# makes them permanently undecryptable, and the only remedy is re-entering
# every one in Settings -> Connections.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Left blank, the service generates one into .secrets/master.key on first run.
# That is a single-machine convenience: Windows ignores the file permissions,
# and a key next to its own ciphertext protects against very little. Set it
# here, or in the host's secret manager, anywhere that matters.
SECRETS_MASTER_KEY=

# Which workspace this deployment serves. One deployment, one business -- the
# dashboard never asks. Defaults to the first entry in LEADGEN_TENANTS.
LEADGEN_WORKSPACE=example_tenant

# The dashboard's dev server proxies /api, so cross-origin requests are not
# normally involved. Only turn this on if the two run on different hosts.
BACKEND_ALLOW_CORS=false
BACKEND_CORS_ORIGINS=http://localhost:5173
